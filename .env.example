# Copy to .env.local (git-ignored) and fill in. Only browser-safe values go
# here: never a service-role / secret key or an OpenAI key.

# demo     = Demo Mode: mock login and mock data; never contacts Supabase.
# supabase = Supabase Mode: real login and the integrations listed below.
# Unset: Supabase Mode if VITE_SUPABASE_INTEGRATIONS lists anything, else Demo Mode.
VITE_APP_MODE=

# Supabase project URL and publishable (anon) key — Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Which parts of the app use Supabase instead of the prototype's mock data,
# as a comma-separated list. Empty = everything stays on mock data.
# Available: auth, classes, lessonPlanning, lessonGeneration, lessonRevision,
#   lessonBrainstorm, practiceActivity, studentFeedback, classFeedback
# lessonGeneration: Generate Lesson calls the partners-generate-lesson Edge Function
#   (OpenAI) instead of the built-in mock. The function also has to be deployed and
#   switched on server-side (LESSON_GENERATION_ENABLED + allowed test accounts).
# lessonRevision: the Revise Lesson chat answers with partners-revise-lesson (OpenAI)
#   and saves each exchange to the lesson's revision history. Same server switch,
#   allowlist, and key as lessonGeneration.
# lessonBrainstorm: Brainstorm with AI replies come from partners-brainstorm (OpenAI),
#   and the chat is saved with the lesson when Generate saves it. Same server switch,
#   allowlist, and key as lessonGeneration.
# practiceActivity: Science Practice Activity drafts come from partners-generate-activity
#   (OpenAI); a confirmed activity is saved (with its brainstorm) like a lesson, and
#   confirming its student work creates its Student Feedback Page. Same server switch,
#   allowlist, and key as lessonGeneration.
# studentFeedback: saved Student Feedback Pages (the page link students open, sign-in
#   with their class Student ID, submissions, revisions, AI feedback) through the
#   partners-student-page Edge Function, and the Library's Student Feedback button.
#   Student uploads, submissions, and AI feedback also need the server's
#   PARTNERS_PROTOTYPE_WRITES=true (off by default).
# classFeedback: Class Feedback (statistics, AI class summary with its student work,
#   discussion, next steps, facilitation questions) and Individual Student Reports
#   through the partners-class-feedback Edge Function. AI parts use the same server
#   switch, allowlist, and key as lessonGeneration.
VITE_SUPABASE_INTEGRATIONS=

# Used only by `npm run gen:types` (not by the app): the project ref from
# the dashboard URL, https://supabase.com/dashboard/project/<ref>.
SUPABASE_PROJECT_ID=
