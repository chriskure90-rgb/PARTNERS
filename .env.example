# Copy to .env.local (git-ignored) and fill in. Only browser-safe values go
# here: never a service-role / secret key or an OpenAI key.

# demo     = Demo Mode: mock login and mock data; never contacts Supabase.
# supabase = Supabase Mode: real login and the integrations listed below.
# Unset: Supabase Mode if VITE_SUPABASE_INTEGRATIONS lists anything, else Demo Mode.
VITE_APP_MODE=

# Supabase project URL and publishable (anon) key — Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Which parts of the app use Supabase instead of the prototype's mock data,
# as a comma-separated list. Empty = everything stays on mock data.
# Available now: auth   (later: classes, lessonPlanning, studentFeedback, classFeedback)
VITE_SUPABASE_INTEGRATIONS=

# Used only by `npm run gen:types` (not by the app): the project ref from
# the dashboard URL, https://supabase.com/dashboard/project/<ref>.
SUPABASE_PROJECT_ID=
